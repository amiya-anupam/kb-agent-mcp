# ─────────────────────────────────────────────────────────────
#  KnowledgeBase Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
#  .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────

# ── Root directory ────────────────────────────────────────────
# Absolute path to the folder containing your knowledge domains.
# Defaults to the directory where generate.py lives if not set.
# KB_ROOT=/path/to/your/KnowledgeBase

# ── LLM Provider ─────────────────────────────────────────────
# Supported: ollama | openai | anthropic | custom
# - ollama:    local Ollama server (default)
# - openai:    OpenAI API
# - anthropic: Anthropic API
# - custom:    any OpenAI-compatible endpoint (LM Studio, Jan, etc.)
KB_LLM_PROVIDER=ollama

# Base URL for the LLM API.
# - Ollama default:      http://localhost:11434
# - OpenAI default:      https://api.openai.com/v1
# - Anthropic default:   https://api.anthropic.com
# - Custom (LM Studio):  http://localhost:1234/v1
KB_LLM_BASE_URL=http://localhost:11434

# Model name to use for Q&A and routing.
# - Ollama examples:   qwen3:14b, llama3.2, mistral
# - OpenAI examples:   gpt-4o, gpt-4o-mini
# - Anthropic examples: claude-3-5-haiku-20241022
KB_MODEL=qwen3:14b

# API key — required for openai / anthropic / custom providers.
# Leave blank for Ollama.
# KB_API_KEY=sk-...

# ── Embedding Model ───────────────────────────────────────────
# Model used to embed documents for semantic search.
# - Ollama: any model pulled via `ollama pull <model>`
# - OpenAI: text-embedding-3-small, text-embedding-ada-002
# - Leave blank to use the offline sentence-transformers fallback
#   (all-MiniLM-L6-v2, ~80MB, auto-downloaded, no API needed)
KB_EMBED_MODEL=nomic-embed-text

# ── Folder Discovery ──────────────────────────────────────────
# Comma-separated list of top-level folder names to ignore
# during domain discovery (in addition to the built-in blocklist).
# Example: KB_IGNORE_FOLDERS=Private,Archive,Temp
# KB_IGNORE_FOLDERS=
