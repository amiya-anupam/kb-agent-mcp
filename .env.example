# ─────────────────────────────────────────────────────────────
#  KnowledgeBase Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
#  .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────

# ── Root directory ────────────────────────────────────────────
# Absolute path to the folder containing your knowledge domains.
# Defaults to the directory where generate.py lives if not set.
# KB_ROOT=/path/to/your/KnowledgeBase

# ── LLM Provider ─────────────────────────────────────────────
# Supported: ollama | openai | anthropic | custom | passthrough
# - ollama:       local Ollama server (default)
# - openai:       OpenAI API
# - anthropic:    Anthropic API
# - custom:       any OpenAI-compatible endpoint (LM Studio, Jan, etc.)
# - passthrough:  no local LLM — Bob's Claude answers using retrieved context
KB_LLM_PROVIDER=ollama

# Base URL for the LLM API.
# - Ollama default:      http://localhost:11434
# - OpenAI default:      https://api.openai.com/v1
# - Anthropic default:   https://api.anthropic.com
# - Custom (LM Studio):  http://localhost:1234/v1
KB_LLM_BASE_URL=http://localhost:11434

# Model name to use for Q&A and routing.
# - Ollama examples:   qwen3:14b, llama3.2, mistral
# - OpenAI examples:   gpt-4o, gpt-4o-mini
# - Anthropic examples: claude-3-5-haiku-20241022
KB_MODEL=qwen3:14b

# API key — required for openai / anthropic / custom providers.
# Leave blank for Ollama.
# KB_API_KEY=sk-...

# ── Passthrough / offline mode ────────────────────────────────
# When KB_LLM_PROVIDER=ollama and no KB_API_KEY is set, the agent
# automatically falls back to passthrough mode if Ollama is unreachable.
# Set to false to disable this auto-detection (useful when you want
# the agent to error rather than silently switch to passthrough).
# Default: true
# KB_PASSTHROUGH_FALLBACK=true

# ── Embedding Model ───────────────────────────────────────────
# Model used to embed documents for semantic search.
# - Ollama: any model pulled via `ollama pull <model>`
# - OpenAI: text-embedding-3-small, text-embedding-ada-002
# - Leave blank to use the offline sentence-transformers fallback
#   (all-MiniLM-L6-v2, ~80MB, auto-downloaded, no API needed)
KB_EMBED_MODEL=nomic-embed-text

# ── Folder Discovery ──────────────────────────────────────────
# Comma-separated list of top-level folder names to ignore
# during domain discovery (in addition to the built-in blocklist).
# Example: KB_IGNORE_FOLDERS=Private,Archive,Temp
# KB_IGNORE_FOLDERS=

# ── Collapse patterns ─────────────────────────────────────────
# Groups of repeated/versioned files to collapse into a single summary
# row in the AUTO-INDEX table instead of listing every file.
# This is the biggest token-saver when you have many files with a
# shared naming convention (weekly reports, dated snapshots, etc.).
#
# Format: pipe-separated triple  pattern|label|description_template
#   pattern              — Python regex matched against the filename (case-insensitive)
#   label                — short group name shown in the index row
#   description_template — supports {n} (file count) and {quarters} (e.g. Q126, Q226)
#
# Separate multiple rules with  ;;
#
# Examples:
#   Weekly pipeline reports named like "EPM2-004 Q126 wk3.xlsx":
#     KB_COLLAPSE_PATTERNS=EPM2-004|EPM weekly snapshots|Weekly files for {quarters} ({n} files)
#
#   Screenshots named "Screenshot 2025-*.png" plus monthly reports:
#     KB_COLLAPSE_PATTERNS=^Screenshot|screenshots|Snapshot images ({n} files);;Monthly_Report|monthly reports|Monthly summary reports ({n} files)
#
# KB_COLLAPSE_PATTERNS=

# ── Stale file detection ──────────────────────────────────────────────────────
# Number of days after which an indexed file is considered stale.
# watch_kb.py checks at startup and then every hour (_STALE_CHECK_INTERVAL=3600s).
# A warning is printed for every file over the threshold, e.g.:
#   ⚠ BizOps: Q3_Renewal_Tracker.xlsx was last updated 112 days ago.
# Set to 0 to disable the staleness check entirely.
# Default: 90
# KB_STALE_DAYS=90

# ── Structured answer format ──────────────────────────────────────────────────
# Default output format injected into the system prompt when no --format flag
# or natural-language phrase is detected in the question.
# Leave unset (or empty) to use the LLM's default formatting.
# Supported values: table | bullets | oneline | paragraph | numbered | json
# Aliases:  bullet | list  →  bullets
#           1line | one-line | one-liner  →  oneline
#           prose | paragraphs  →  paragraph
#           num | numbered-list  →  numbered
# KB_FORMAT_DEFAULT=

# ── Session limits ────────────────────────────────────────────────────────────
# Maximum session idle time before memory is cleared (hours).
# Default: 2
# KB_SESSION_TIMEOUT_HOURS=2

# Maximum conversation turns kept in a single session.
# Default: 20
# KB_SESSION_MAX_TURNS=20

# ── Token / context budgets ───────────────────────────────────────────────────
# Max chars of text sent to the embedding model per file.
# Reduce this if your embed model has a shorter input limit.
# Default: 8000  (~2000 tokens)
# KB_BUDGET_EMBED_CHARS=8000

# Min hand-written chars a README must have (outside the AUTO-INDEX block)
# before the README-first strategy is used. Below this, falls back to RAG.
# Default: 200
# KB_MIN_README_CHARS=200

# Ollama context window size (num_ctx). Reduce for GPUs with less VRAM.
# Default: 32768  (set to 8192 for 8GB GPU, 4096 for smallest models)
# KB_NUM_CTX=32768
