# ─────────────────────────────────────────────────────────────────────────────
# kb-agent-mcp  ·  Environment Configuration
# Copy this file to .env and fill in the values that apply to your setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Knowledge Root ────────────────────────────────────────────────────────────
# Absolute path to the folder containing your knowledge domain subfolders.
# Every top-level subfolder becomes a searchable domain.
KB_ROOT=/path/to/your/knowledge/folder

# Comma-separated folder names to ignore during discovery (on top of defaults).
# Defaults already skip: .kb_index, .git, __pycache__, agents, scripts, tests
# KB_IGNORE_FOLDERS=Private,Archive

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM backend to use for answering questions and generating config.
# Options: ollama | openai | anthropic | custom | passthrough
KB_LLM_PROVIDER=ollama

# Base URL for the LLM API endpoint.
# Ollama default:     http://localhost:11434
# LM Studio default:  http://localhost:1234/v1
# OpenAI:             https://api.openai.com/v1
# Anthropic:          https://api.anthropic.com
KB_LLM_BASE_URL=http://localhost:11434

# Model name to use for chat completions.
# Ollama examples:    qwen3:14b, llama3.2, mistral
# OpenAI examples:    gpt-4o, gpt-4o-mini
# Anthropic examples: claude-3-5-sonnet-20241022
KB_MODEL=qwen3:14b

# API key — required for openai, anthropic, or custom providers.
# Leave blank for ollama or passthrough.
# KB_API_KEY=sk-...

# If Ollama is unreachable, automatically fall back to passthrough mode
# (context blocks emitted as strings in MCP tool responses).
# Options: true | false
KB_PASSTHROUGH_FALLBACK=true

# ── Embedding Model ───────────────────────────────────────────────────────────
# Model used to generate document and query embeddings.
# Ollama example:  nomic-embed-text
# OpenAI example:  text-embedding-3-small
# Leave blank to use the offline sentence-transformers fallback (all-MiniLM-L6-v2, ~80MB).
# KB_EMBED_MODEL=nomic-embed-text

# Offline / air-gapped environments:
#   Set TRANSFORMERS_OFFLINE=1 to prevent any download attempts.
#   The model must already be cached (~/.cache/huggingface/hub/) on this machine.
#   Pre-download on a networked machine, then copy the cache directory here.
# TRANSFORMERS_OFFLINE=1

#   Set HF_ENDPOINT to use a Hugging Face mirror or internal proxy.
#   Example: HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=

# ── Context / Token Budgets ────────────────────────────────────────────────────
# All values are in characters (~4 chars = 1 token).
# Increase if your LLM supports a large context window; decrease to save cost.

# Hard ceiling for the total LLM context in a single call.
# KB_BUDGET_TOTAL=24000

# Context budget for the README AUTO-INDEX block (simple questions).
# KB_BUDGET_INDEX=8000

# Context budget when using the full README (complex questions).
# KB_BUDGET_FULL_README=24000

# Budget for the hand-written README intro section.
# KB_BUDGET_PRE_INDEX=2000

# Budget per retrieved file in RAG fallback mode.
# KB_BUDGET_RAG_FILE=4000

# Per-file summary length written into the AUTO-INDEX block.
# KB_BUDGET_SUMMARY=500

# Characters sent to the embedding model per document chunk.
# KB_BUDGET_EMBED_CHARS=3500

# Ollama context window size (num_ctx). Lower this if your GPU has limited VRAM.
# KB_NUM_CTX=32768

# Minimum README characters to consider the README-first strategy worth using.
# KB_MIN_README_CHARS=200

# ── Session Memory ────────────────────────────────────────────────────────────
# Hours of inactivity before a conversation session is automatically reset.
# KB_SESSION_TIMEOUT_HOURS=2

# Maximum number of conversation turns kept in memory per session.
# KB_SESSION_MAX_TURNS=20

# Maximum characters of an assistant answer stored in memory (prevents bloat).
# KB_SESSION_MAX_ANSWER_CHARS=400

# ── File Discovery & Stale-Index Detection ────────────────────────────────────
# Days threshold after which a file is considered stale in log warnings.
# KB_STALE_DAYS=90

# Seconds between filesystem scans to detect new unindexed files.
# Set to 0 to disable stale-index warnings in ask().
# KB_STALE_CHECK_TTL_SECONDS=60

# ── Passthrough Budget (Risk 14) ──────────────────────────────────────────────
# Fraction of KB_BUDGET_TOTAL at which passthrough top_n is auto-reduced.
# When the estimated context size exceeds (KB_BUDGET_TOTAL * threshold), the
# agent reduces top_n per domain to stay under budget.
# Range: 0.0–1.0. Default: 0.8 (80% of total budget).
# KB_BUDGET_PASSTHROUGH_THRESHOLD=0.8

# ── LLM Provider Override for Generate ───────────────────────────────────────
# Optional: use a different LLM provider for kb-agent-generate (YAML generation)
# than for runtime Q&A. Written automatically by kb-agent-setup when you choose
# passthrough mode but provide an API key for generate.
# Options: ollama | openai | anthropic | custom
# KB_LLM_PROVIDER_GENERATE=

# ── Output Format ─────────────────────────────────────────────────────────────
# Default answer format when none is specified by the caller.
# Options: table | bullets | oneline | paragraph | numbered | json
# KB_FORMAT_DEFAULT=paragraph
