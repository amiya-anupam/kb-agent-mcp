# ── Environment ───────────────────────────────────────────────
.env

# ── Bob scratch / session files ───────────────────────────────
.bob/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
.pytest_cache/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Vector store (derived — rebuilt by generate.py) ───────────
agents/vector_store/*.json

# ── Auto-generated domain agents (rebuilt by generate.py) ─────
# Only the four core portable agents are committed:
#   agent_base.py, agent_knowledgebase.py, embeddings.py, memory.py
# Domain-specific agents (agent_ace_docs.py, agent_bizops.py, etc.)
# are generated locally by running: python3 generate.py
# They are intentionally excluded — each user generates their own.

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────
*.log
.watch.log

# ── One-off HTML artifacts ────────────────────────────────────
*.html
!architecture-flow-diagram-kb-agent-mcp.html

# ── Knowledge folder contents (private / local data) ─────────
# Knowledge folders contain private documents — never commit them.
# Add your own folders below following the same pattern if needed.

ACE Docs/
BizOps/
CP4I Docs/

# ── skills/ directory ───────────────────────────────────────────
# Prevent generate.py from treating skills/ as a knowledge domain
# and committing auto-generated README stubs.
skills/*.md

# ── Auto-generated domain agents (patterns) ───────────────────
agents/agent_ace_docs.py
agents/agent_bizops.py
agents/agent_cp4i_docs.py
agents/agent_skills.py
agents/agent_d.py
agents/agent_*_egg_info.py

# ── Test scaffold artefacts (created by E2E test suite) ────────
# These are written to the working tree by tests that ran before
# the isolated_kb fixture fully contained writes. Adding them
# here ensures they can never be accidentally committed if a
# future test run leaks them again.
MyDomain/
no_domain_file.md
agents/agent_mydomain.py

# ── ChromaDB vector index (local, rebuilt by kb-agent-generate) ──
.kb_index/


# ── VSCode workspace file (personal / local) ─────────────────────
*.code-workspace

# ── skills/ auto-generated config ────────────────────────────────
skills/*.yaml
